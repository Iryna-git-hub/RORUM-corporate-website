# Formspree configuration. Replace the form ID after creating the form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/FORM_ID_PLACEHOLDER

# Configure this recipient in the Formspree dashboard. This value is kept as
# deployment documentation and is not submitted by the browser.
FORMSPREE_RECIPIENT_EMAIL=RECIPIENT_EMAIL_TO_BE_PROVIDED
