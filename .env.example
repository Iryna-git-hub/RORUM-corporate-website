# Formspree configuration. Replace the form ID after creating the form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/FORM_ID_PLACEHOLDER

# Configure this recipient in the Formspree dashboard. This value is kept as
# deployment documentation and is not submitted by the browser.
FORMSPREE_RECIPIENT_EMAIL=RECIPIENT_EMAIL_TO_BE_PROVIDED

# --- Sanity CMS ---------------------------------------------------------
# From sanity.io/manage → your project → Settings. Required for the site to
# read published content and for /studio to load at all.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned API version — do not set this to a dynamically generated date. See
# sanity/env.ts for the current default if you leave this unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only. A Viewer-role token, needed to read draft content (Draft Mode
# / Presentation Tool preview). Never expose this as NEXT_PUBLIC_*.
SANITY_API_READ_TOKEN=

# Server-only, local use only (the `npm run sanity:import` script). An
# Editor-role token. Never commit a real value; never expose to the browser.
SANITY_API_WRITE_TOKEN=

# Server-only. Shared secret used to validate requests to the Draft Mode
# enable route before entering preview.
SANITY_PREVIEW_SECRET=
