# Formspree — ONE endpoint for EVERY form on the site (Contact, Volunteer,
# Work With Us, Catering, Event Decoration, Host at RORUM). Create/select a
# single Formspree form, set its recipient to the address below in the
# Formspree dashboard, then paste its endpoint here (replace the form ID).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/FORM_ID_PLACEHOLDER

# The approved recipient. Configured on the Formspree FORM, never submitted by
# the browser and never referenced in application code — kept here only as
# deployment documentation. Each submission carries a `form_name` +
# `[RoRUM] <form type>` subject so Gmail filters can route them.
FORMSPREE_RECIPIENT_EMAIL=rorum2025@gmail.com

# REQUIRED. The exact public HTTPS origin this deployment is served from —
# the ONLY thing that makes canonical/hreflang URLs, Open Graph/Twitter URLs,
# the sitemap, robots.txt, JSON-LD, and Sanity Studio's SEO preview correct
# for THIS deployment. No trailing slash, no path/query — a bare origin.
# Production: https://ro-rum.dk
# A Netlify preview/staging deploy: https://<site-name>.netlify.app (or
# .netlify.live for a deploy preview)
# Missing, empty, malformed, non-HTTPS, or a localhost/loopback address all
# fail the build loudly (see shared/siteIdentity.ts) — there is no silent
# fallback to any hardcoded domain, so this MUST be set correctly in every
# environment's own deployment configuration (including Netlify's dashboard
# for each site/branch) before deploying.
NEXT_PUBLIC_SITE_URL=

# --- Sanity CMS ---------------------------------------------------------
# From sanity.io/manage → your project → Settings. Required for the site to
# read published content and for /studio to load at all.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned API version — do not set this to a dynamically generated date. See
# sanity/env.ts for the current default if you leave this unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only. A Viewer-role (read-only) token. REQUIRED for the Sanity
# Presentation Tool + Next.js Draft Mode preview (see app/api/draft-mode/*):
# the enable route validates Presentation's one-time preview secret against
# the dataset with this token, then serves draft content server-side. Without
# it the site still works for normal visitors (published content only) and the
# enable route returns 501. Never expose this as NEXT_PUBLIC_*; never reuse
# the write token below for it.
SANITY_API_READ_TOKEN=

# Server-only, local use only (the `npm run sanity:*` import/migration
# scripts). An Editor-role token. Never commit a real value; never expose to
# the browser; never imported into the Next.js runtime.
SANITY_API_WRITE_TOKEN=

# OPTIONAL. Only set this if the Studio is opened from a DIFFERENT origin than
# the site it should preview (e.g. a Netlify deploy-preview Studio pointed at
# production). Normally leave it blank: the Studio is embedded at /studio on
# the same origin as the site, so Presentation previews a relative "/" and
# needs no per-environment value. It is only a URL, never a secret.
# Example value: https://ro-rum.dk
NEXT_PUBLIC_SANITY_PREVIEW_ORIGIN=

# --- Billetto ticketing --------------------------------------------------
# OPTIONAL, server-only. Powers live "spots left" ticket availability on
# Home/Events/event pages for any event whose Sanity "Billetto event link"
# field is set — see BILLETTO_TICKETING.md. If unset, the site still builds
# and runs normally; Billetto-connected events just fall back to their
# manual Sanity availability (no live count, never a false "Sold out").
# Never NEXT_PUBLIC_*, never exposed to the browser (lib/billetto.ts is
# `server-only`). From your Billetto API Key Pair.
BILLETTO_API_KEY_ID=
BILLETTO_ACCESS_KEY_SECRET=
