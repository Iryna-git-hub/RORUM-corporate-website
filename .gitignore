# Sanity TypeGen output IS committed (types depend on it at build time);
# do not add sanity.types.ts here.

# Local JSON backups written by one-off migration/cleanup scripts before a
# destructive operation (e.g. scripts/delete-orphaned-legacy-docs.ts) — not
# meant to be committed, just a local safety net for that run.
/scripts/backups/
